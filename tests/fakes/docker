#!/usr/bin/env bash
# A fake docker for the shell-script tests. Records each call, one per line, in
# $FAKE_DOCKER_LOG. Keeps what is "running" in $FAKE_DOCKER_STATE. Told to fail with:
#   FAKE_FAIL_PULL=1        docker compose pull fails
#   FAKE_FAIL_UP=1          docker compose up fails
#   FAKE_UNHEALTHY_IMAGE=x  an app container running image x reports "unhealthy"
#   FAKE_GATE_DOWN=1        the gate container is not running
#   FAKE_GATE_RESTARTING=1  the gate is running, but its RestartCount goes up at every look
#   FAKE_DUMP_EMPTY=1       pg_dump writes nothing
#   FAKE_BLOCK_ON=pull      the first "compose pull" writes $state/blocked and waits (up to 30 s)
#   FAKE_BLOCK_ON=health    for $state/release, so a test can signal the deploy there, or start
#                           a second one, and then let it go on (health: the first health check)
# Each "compose pull" also writes the mode of .env.previous, if it exists, to
# $state/previous_mode.
set -u
printf '%s\n' "$*" >> "$FAKE_DOCKER_LOG"
state="$FAKE_DOCKER_STATE"

block_once() {
  if [ "${FAKE_BLOCK_ON:-}" = "$1" ] && [ ! -e "$state/blocked" ]; then
    : > "$state/blocked"
    for _ in $(seq 600); do
      [ -e "$state/release" ] && return 0
      sleep 0.05
    done
  fi
}

# APP_IMAGE as docker compose reads it from .env (checked against docker compose config):
# a CR and surrounding spaces are not part of the value; a quoted value ends at its closing
# quote (anything after it, such as " # comment", is ignored); an unquoted value ends before
# a " # comment".
app_image_from_env() {
  local v q
  v="$(sed -n 's/^APP_IMAGE=//p' .env | tail -n 1 | tr -d '\r')"
  v="$(printf '%s' "$v" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
  case "$v" in
    \"* | \'*) q="${v:0:1}" v="${v:1}" v="${v%%"$q"*}" ;;
    *) v="$(printf '%s' "$v" | sed -e 's/[[:space:]]#.*$//' -e 's/[[:space:]]*$//')" ;;
  esac
  printf '%s\n' "$v"
}

case "$*" in
  "compose exec -T db pg_dump"*)
    [ "${FAKE_DUMP_EMPTY:-}" = 1 ] || printf 'PGDMP fake dump\n'
    exit 0 ;;
  "compose pull"*)
    if [ -e .env.previous ]; then stat -c %a .env.previous > "$state/previous_mode"; fi
    block_once pull
    [ "${FAKE_FAIL_PULL:-}" = 1 ] && exit 1
    exit 0 ;;
  "compose up -d"*)
    [ "${FAKE_FAIL_UP:-}" = 1 ] && exit 1
    app_image_from_env > "$state/running_image"
    exit 0 ;;
  "compose ps -q app")
    [ -s "$state/running_image" ] && echo fake-app-id
    exit 0 ;;
  "compose ps -q gate")
    echo fake-gate-id
    exit 0 ;;
esac

if [ "${1:-}" = inspect ] && [ "${2:-}" = --format ]; then
  format="$3" id="$4"
  running="$(cat "$state/running_image" 2>/dev/null || true)"
  case "$id:$format" in
    fake-app-id:*Config.Image*) echo "$running" ;;
    fake-app-id:*Health*)
      block_once health
      if [ -n "${FAKE_UNHEALTHY_IMAGE:-}" ] && [ "$running" = "$FAKE_UNHEALTHY_IMAGE" ]; then
        echo unhealthy
      else
        echo healthy
      fi ;;
    fake-gate-id:*State.Running*)
      if [ "${FAKE_GATE_DOWN:-}" = 1 ]; then echo false; else echo true; fi ;;
    fake-gate-id:*RestartCount*)
      count="$(cat "$state/gate_restarts" 2>/dev/null || echo 0)"
      if [ "${FAKE_GATE_RESTARTING:-}" = 1 ]; then
        count=$((count + 1))
        echo "$count" > "$state/gate_restarts"
      fi
      echo "$count" ;;
    *) echo "fake docker: unknown inspect $id $format" >&2; exit 1 ;;
  esac
  exit 0
fi

echo "fake docker: unexpected call: $*" >&2
exit 1
