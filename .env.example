# Names only. The real values live in /opt/pubmedgemini/.env on the VPS (mode 600).
APP_IMAGE=
APP_HOST=
OWNER_EMAIL=
POSTGRES_PASSWORD=
DATABASE_URL=
OAUTH2_PROXY_CLIENT_ID=
OAUTH2_PROXY_CLIENT_SECRET=
OAUTH2_PROXY_COOKIE_SECRET=
TRAEFIK_NETWORK=
TRAEFIK_SUBNET=
TRAEFIK_ENTRYPOINT=
TRAEFIK_CERTRESOLVER=
# Seals each doctor's own Gemini key into their browser cookie: 32 random bytes, base64 (infra/README.md).
KEY_COOKIE_SECRET=
# Optional: the app runs without them. A free NCBI key raises PubMed's limit from 3 to 10 requests a second.
NCBI_API_KEY=
NCBI_EMAIL=
# Optional: the model and each doctor's free-tier limits (defaults if blank). There is no Gemini key here: each doctor uses their own.
GEMINI_MODEL=
GEMINI_RPM=
GEMINI_TPM=
GEMINI_RPD=
# Optional: questions running at once for the whole app (default 2).
MAX_ACTIVE_RUNS=
