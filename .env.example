# Names only. The real values live in /opt/pubmedgemini/.env on the VPS (mode 600).
APP_IMAGE=
APP_HOST=
OWNER_EMAIL=
POSTGRES_PASSWORD=
DATABASE_URL=
OAUTH2_PROXY_CLIENT_ID=
OAUTH2_PROXY_CLIENT_SECRET=
OAUTH2_PROXY_COOKIE_SECRET=
TRAEFIK_NETWORK=
TRAEFIK_SUBNET=
TRAEFIK_ENTRYPOINT=
TRAEFIK_CERTRESOLVER=
# Optional: the app runs without them. A free NCBI key raises PubMed's limit from 3 to 10 requests a second.
NCBI_API_KEY=
NCBI_EMAIL=
# Optional: questions need a Gemini key from Google AI Studio, made in a Google project with billing turned off. The others have defaults.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_RPM=
GEMINI_TPM=
GEMINI_RPD=
